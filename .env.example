# Copy to .env and fill in. NEVER commit .env or paste keys into chats.

# ---------- Mode ----------
# true = do everything except spend SOL (simulate the launch). Start here.
DRY_RUN=true
# Also upload logo + metadata to IPFS during dry runs (uses Pinata quota)
DRY_RUN_UPLOAD=false

# ---------- Solana ----------
# Paid/free RPC from Helius, QuickNode, Ankr... (public mainnet RPC can't send txs)
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Optional backups, comma separated (used automatically if the main one fails)
SOLANA_RPC_URLS_FALLBACK=https://rpc.ankr.com/solana
# Phantom: Settings -> Manage Accounts -> (wallet) -> Show Private Key. base58 string or [1,2,...] array.
# Use a SEPARATE wallet for the bot with only what you are willing to risk.
SIGNER_PRIVATE_KEY=

# ---------- pump.fun options ----------
PUMP_API_BASE=https://fun-block.pump.fun
PUMP_COINS_API=https://frontend-api-v3.pump.fun
FRONT_RUNNING_PROTECTION=false
JITO_TIP_SOL=0.0001
MAYHEM_MODE=false
CASHBACK=false

# ---------- Trend sources ----------
DEXSCREENER_API_URL=https://api.dexscreener.com
# Optional (paid X API plan). Without it the bot uses DexScreener only.
X_API_BEARER_TOKEN=
X_SEARCH_QUERY=(memecoin OR pumpfun OR "pump.fun" OR solana meme) -is:retweet lang:en

# ---------- AI (set both LLM keys to get the Claude vs GPT contest) ----------
# ---- FREE options (recommended) ----
# Ollama on your own PC (fully free). Pull a vision model: ollama pull gemma3
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma3
# Optional second local model so two AIs compete, e.g. qwen2.5vl or llama3.2-vision
OLLAMA_MODEL_2=
# Groq free tier: https://console.groq.com/keys
GROQ_API_KEY=
# Google Gemini free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Hugging Face (free monthly credits): https://huggingface.co/settings/tokens
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_IMAGE_PROVIDER=nscale
# Pollinations (free Flux logos, no key). Optional token: https://auth.pollinations.ai
POLLINATIONS_ENABLED=true
POLLINATIONS_TOKEN=
# ---- Paid options (optional) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=dall-e-3
# Flux via fal.ai (https://fal.ai/dashboard/keys). Set with OPENAI_API_KEY for the DALL-E vs Flux contest.
FAL_KEY=
FLUX_MODEL=fal-ai/flux/dev

# ---------- IPFS (https://app.pinata.cloud -> API Keys -> JWT) ----------
PINATA_JWT=
IPFS_GATEWAY=https://ipfs.io/ipfs/

# ---------- Strategy & risk limits (start low) ----------
# Only launch when a trend scores at least this (0-1). Higher = fewer, better launches.
MIN_TREND_SCORE=0.55
# Initial buy scales with trend strength between these two values
INITIAL_BUY_MIN_SOL=0.01
INITIAL_BUY_MAX_SOL=0.05
MAX_DAILY_SPEND_SOL=0.2
MAX_LAUNCHES_PER_DAY=3
# Bot never lets the wallet drop below this
MIN_WALLET_RESERVE_SOL=0.05
# Rent + network fees per launch (estimate)
LAUNCH_COST_BUFFER_SOL=0.03
# Launch only in these UTC hours, e.g. 13-23 (US daytime). Empty = any time.
LAUNCH_HOURS_UTC=13-23
# Don't reuse a theme within this many hours
THEME_COOLDOWN_HOURS=48
# A coin counts as a success if it graduates or reaches this market cap after 24h
SUCCESS_MCAP_USD=15000
# Pause launching after this many flops in a row, for PAUSE_HOURS
LOSS_STREAK_PAUSE=5
PAUSE_HOURS=24
# Creator-fee harvesting: collect when net gain >= this, check each coin every N minutes
FEE_COLLECT_MIN_SOL=0.002
FEE_COLLECT_INTERVAL_MIN=360
# Extra words the bot must never use in a name/ticker, comma separated
BLOCKED_TERMS=

# ---------- "Don't copy" check ----------
# Skip any idea whose ticker (or exact name) already exists on pump.fun or a Solana DEX
TICKER_CHECK_ENABLED=true
# If pump.fun AND DexScreener search are both down: false = skip that idea (safe), true = allow
TICKER_CHECK_FAIL_OPEN=false

# ---------- Auto-posting (live launches only; dry runs write out/<run>/posts-preview.txt) ----------
# Telegram: create a bot with @BotFather, add it to your channel as an admin.
TELEGRAM_BOT_TOKEN=
# Public channel: @yourchannel   Private channel: -100xxxxxxxxxx
TELEGRAM_CHANNEL_ID=
# X: developer.x.com -> your app -> "Keys and tokens". App permissions must be "Read and write",
# then (re)generate the Access Token + Secret so they carry write access.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
POST_DISCLAIMER=Just a meme coin, no promises. Not financial advice - DYOR.

# ---------- Runtime ----------
# Run a cycle every N minutes. 0 = only when triggered (POST /run, e.g. from n8n).
CYCLE_INTERVAL_MIN=60
PORT=8080
# Long random string. n8n sends it as "Authorization: Bearer <token>";
# it is also the dashboard password (any username) at https://<your-app>/dashboard
AGENT_API_TOKEN=
# n8n Webhook URL to receive launch / error / fees / pause alerts
NOTIFY_WEBHOOK_URL=
DATA_DIR=./data
OUT_DIR=./out
LOG_LEVEL=info

# ---------- n8n pipeline (optional) ----------
# n8n webhook the bot reports its Cloudflare tunnel URL to (scripts/tunnel.cjs).
N8N_CHECKIN_URL=
