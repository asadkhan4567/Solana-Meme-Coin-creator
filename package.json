{
  "name": "solana-meme-coin-creator",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous pump.fun meme coin agent: trend scan -> AI name/logo (Claude vs GPT, DALL-E vs Flux) -> IPFS -> on-chain launch, with dry run, budgets and self-healing.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "once": "tsx src/index.ts --once",
    "collect-fees": "tsx src/index.ts --collect-fees",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "dotenv": "^17.4.2",
    "openai": "^6.49.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
